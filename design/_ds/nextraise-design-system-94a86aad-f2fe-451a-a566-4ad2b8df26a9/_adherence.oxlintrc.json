{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/patterns/**",
              "ui_kits/extension/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Plus Jakarta Sans Fallback|Plus Jakarta Sans))/i]",
        "message": "Font not provided by the design system. Available: Plus Jakarta Sans Fallback, Plus Jakarta Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Accordion'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|defaultOpen|style|key|ref|className|style|children)$/]",
        "message": "<Accordion> doesn't accept that prop. Declared props: items, defaultOpen, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnnouncementBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|ctaLabel|href|style|key|ref|className|style|children)$/]",
        "message": "<AnnouncementBar> doesn't accept that prop. Declared props: text, ctaLabel, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AtsScoreCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:score|verdict|note|target|fixes|onFixAll|style|key|ref|className|style|children)$/]",
        "message": "<AtsScoreCard> doesn't accept that prop. Declared props: score, verdict, note, target, fixes, onFixAll, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AutofillPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:company|role|applicants|score|fields|filled|total|credits|logoSrc|onAutofill|style|key|ref|className|style|children)$/]",
        "message": "<AutofillPanel> doesn't accept that prop. Declared props: company, role, applicants, score, fields, filled, total, credits, logoSrc, onAutofill, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|size|verified|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, name, size, verified, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|icon|dot|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, icon, dot, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:brand|solid|ink|success|neutral|warning|danger|info|live)$/]",
        "message": "<Badge> tone must be one of 'brand' | 'solid' | 'ink' | 'success' | 'neutral' | 'warning' | 'danger' | 'info' | 'live'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|caps|icon|iconAfter|block|disabled|as|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, caps, icon, iconAfter, block, disabled, as, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|accent|secondary|soft|ghost|success)$/]",
        "message": "<Button> variant must be one of 'primary' | 'accent' | 'secondary' | 'soft' | 'ghost' | 'success'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|padding|tone|hoverable|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, padding, tone, hoverable, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|muted|brand|success|dark)$/]",
        "message": "<Card> tone must be one of 'default' | 'muted' | 'brand' | 'success' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|selected|count|icon|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children, selected, count, icon, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|hint|error|value|placeholder|type|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, icon, hint, error, value, placeholder, type, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='JobFilterBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:countries|onSearch|style|key|ref|className|style|children)$/]",
        "message": "<JobFilterBar> doesn't accept that prop. Declared props: countries, onSearch, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='JobMatchCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:company|logo|title|posted|meta|location|level|department|workModel|employment|salary|score|breakdown|skills|extraSkills|footnote|onApply|onScore|onClick|style|key|ref|className|style|children)$/]",
        "message": "<JobMatchCard> doesn't accept that prop. Declared props: company, logo, title, posted, meta, location, level, department, workModel, employment, salary, score, breakdown, skills, extraSkills, footnote, onApply, onScore, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoMarquee'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|label|speed|style|key|ref|className|style|children)$/]",
        "message": "<LogoMarquee> doesn't accept that prop. Declared props: items, label, speed, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|caption|height|tone|style|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, label, caption, height, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReferralRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|role|relation|tag|verified|avatar|onAsk|style|key|ref|className|style|children)$/]",
        "message": "<ReferralRow> doesn't accept that prop. Declared props: name, role, relation, tag, verified, avatar, onAsk, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScoreRing'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|size|thickness|label|onDark|tone|style|key|ref|className|style|children)$/]",
        "message": "<ScoreRing> doesn't accept that prop. Declared props: value, size, thickness, label, onDark, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|options|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label, options, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|logoSrc|style|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: columns, logoSrc, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:links|active|onNavigate|logoSrc|cta|style|key|ref|className|style|children)$/]",
        "message": "<SiteNav> doesn't accept that prop. Declared props: links, active, onNavigate, logoSrc, cta, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|align|size|style|key|ref|className|style|children)$/]",
        "message": "<StatBlock> doesn't accept that prop. Declared props: value, label, align, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<StatBlock> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<StatBlock> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TailoredResumeCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:score|name|summary|skills|experience|changes|style|key|ref|className|style|children)$/]",
        "message": "<TailoredResumeCard> doesn't accept that prop. Declared props: score, name, summary, skills, experience, changes, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TestimonialCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|name|title|location|avatar|style|key|ref|className|style|children)$/]",
        "message": "<TestimonialCard> doesn't accept that prop. Declared props: quote, name, title, location, avatar, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|tone|logoSrc|suffix|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: size, tone, logoSrc, suffix, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|onDark)$/]",
        "message": "<Wordmark> tone must be one of 'default' | 'onDark'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
